module Lib
  module TL1
    module Huawei
      module Message
        class LstOntEthPortPerf < Input
          def initialize: (
            ?did: parameter?,
            ?dev: parameter?,
            ?frame_number: parameter?,
            ?slot_number: parameter?,
            ?port_number: parameter?,
            ?ont_id: parameter?,
            ?ont_name: parameter?,
            ?ont_alias: parameter?,
            ?ont_port_type: parameter?,
            ?ont_port_id: parameter?
          ) -> void
          attr_reader did: parameter?
          attr_reader dev: parameter?
          attr_reader frame_number: parameter?
          attr_reader slot_number: parameter?
          attr_reader port_number: parameter?
          attr_reader ont_id: parameter?
          attr_reader ont_name: parameter?
          attr_reader ont_alias: parameter?
          attr_reader ont_port_type: parameter?
          attr_reader ont_port_id: parameter?
          alias fn frame_number
          alias pn port_number
          alias sn slot_number
        end
      end
    end
  end
end
